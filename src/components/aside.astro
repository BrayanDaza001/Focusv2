---
import { Icon } from "astro-icon/components";
import Link from "./Links/Link.astro";
import LinkList from "./Links/LinkList.astro";
---

<aside
  id="asideMenu"
  class="fixed inset-y-0 left-0 z-40 flex w-48 shrink-0 flex-col overflow-x-hidden border-r-0.5 border-slate-800 overflow-y-auto bg-slate-200/90 text-slate-800 transition-[width,transform] duration-180 ease-out md:static md:w-56 md:translate-x-0 xl:w-60 2xl:w-64 border-r border-r-slate-800/20 shadow-sm"
>
  <div
    class="container mx-auto flex items-center justify-between h-[120px] px-4 border-r-slate-800"
  >
    <div class="flex flex-col items-start w-full">
      <span
        class="text-lg font-bold flex items-center justify-center text-center w-full"
        >Reporte Facturacion</span
      >
      <span
        class="text-sm font-light flex items-center justify-center text-center w-full"
        >Oca Global</span
      >
    </div>
    <button
      id="aside-close-button"
      class="hidden inline-flex h-10 w-10 items-center justify-center rounded-full bg-slate-700 text-slate-800 transition hover:bg-slate-600 focus:outline-none focus:ring-2 focus:ring-orange-500 md:hidden"
      aria-label="Cerrar menú"
    >
      <Icon name="close" class="w-5 h-5" />
    </button>
  </div>

  <div class="relative h-full">
    <div
      class="container mx-auto flex items-center mt-10 transition-colors duration-150 hover:text-white hover:cursor-pointer opacity-0 pointer-events-none absolute left-0 border-r-slate-800 border-r-2"
      id="btn-atras"
    >
      <span class="material-icons-outlined text-3xl ml-3">
        <Icon name="arrow-left" class="w-6 h-6 text-slate-800" />
      </span>
      <span>Atras</span>
    </div>
    <nav
      class="space-y-4 pb-6 pt-6 w-full transition-all duration-300"
      id="menu_start"
    >
      <h2 class="pl-4 text-slate-600 text-sm uppercase tracking-wide">
        Inicio
      </h2>
      <LinkList name="Facturacion" id="facturacion" description="Facturacion" />
      <LinkList name="Soporte" id="soporte" description="Soporte" />
      <LinkList
        name="Coordinador IT"
        id="btn_cordinador"
        description="Coordinador IT"
      />
    </nav>
    <nav
      class="space-y-4 border-b border-gray-500 pb-6 pt-6 opacity-0 pointer-events-none absolute inset-x-0 w-full -translate-y-5 transition-all duration-300"
      id="menuFacturacion"
    >
      <h2 class="pl-4 text-slate-600 text-sm uppercase tracking-wide">
        Facturacion
      </h2>
      <Link
        id="reportes"
        descripcion="Reportes"
        hrefLink="/pantallaMain"
        icon="reporte"
      />
      <Link
        id="dashboard"
        descripcion="Dashboard"
        hrefLink="/dashGlpi"
        icon="dash"
      />
      <Link
        id="alertas"
        descripcion="Alertas"
        hrefLink="/alert"
        icon="alertas"
      />
      <Link id="siigo" descripcion="Siigo" hrefLink="/siigo" icon="siigo" />
      <Link
        id="proveedores"
        descripcion="Proveedores"
        hrefLink="/checkTask"
        icon="checkTask"
      />
    </nav>
    <nav
      class="space-y-4 border-b border-gray-500 pb-6 pt-6 opacity-0 pointer-events-none absolute inset-x-0 w-full -translate-y-5 transition-all duration-300"
      id="menuSoporte"
    >
      <h2 class="pl-4 text-slate-600 text-sm uppercase tracking-wide">
        Soporte
      </h2>
      <Link
        id="movimientos"
        descripcion="Movimientos"
        hrefLink="/movimientos"
        icon="movimientos"
      />
      <Link
        id="consultaYregistro"
        descripcion="Consulta y Registro"
        hrefLink="/consultaYregistro"
        icon="consulta"
      />
      <Link
        id="gestionDeAccesorios"
        descripcion="Accesorios"
        hrefLink="/gestionDeAccesorios"
        icon="acesories"
      />
      <Link
        id="generarPazYsalvo"
        descripcion="Generar Paz y Salvo"
        hrefLink="/gestionDeAccesorios"
        icon="paz"
      />
    </nav>
    <nav
      class="space-y-4 border-b border-gray-500 pb-6 pt-6 opacity-0 pointer-events-none absolute inset-x-0 w-full -translate-y-5 transition-all duration-300"
      id="menuCoordinador"
    >
      <h2 class="pl-4 text-slate-600 text-sm uppercase tracking-wide">
        Coordinador IT
      </h2>
      <Link
        id="paz"
        descripcion="Paz y salvo"
        hrefLink="/pazysalvo"
        icon="paz"
      />
      <Link
        id="reportes"
        descripcion="Reportes"
        hrefLink="/reportes"
        icon="reporte"
      />
    </nav>
    <div>
      <h2 class="pl-4 text-slate-600 text-sm uppercase tracking-wide pt-2">
        Administracion
      </h2>

      <nav class="space-y-3 pb-6 pt-6">
        <Link
          id="configuration"
          descripcion="Configuracion"
          hrefLink="/config/"
          icon="configuration"
        />
        <Link
          id="usuarios"
          descripcion="Usuarios"
          hrefLink="/usuarios"
          icon="usuariosConfig"
        />
      </nav>
    </div>
  </div>

  <div class="mt-auto mb-5 mx-4 w-auto">
    <a
      href="/perfil"
      class="flex w-full items-center gap-3 rounded-3xl p-3 hover:bg-slate-900/30 transition-colors"
    >
      <span
        class="img_perfil_generus w-12 h-12 rounded-full overflow-hidden bg-white p-1 transition-transform duration-700 hover:[transform:rotateY(360deg)]"
      >
        <img
          src="/src/icons/hombre.png"
          alt="Perfil"
          class="w-full h-full object-cover border-2 border-slate-800/20 rounded-full"
        />
      </span>
      <div class="min-w-0 text-left">
        <p class="text-slate-800 text-sm font-semibold truncate">
          Administrador
        </p>
        <p class="text-slate-800/80 text-xs truncate">
          Administrador@ocaglobal.com
        </p>
      </div>
    </a>
  </div>
</aside>
<script src="/src/utils/menuAside/menu.js"></script>
