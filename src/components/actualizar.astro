---
import "../styles/global.css";
---
<div id="loading-screen" 
     class="fixed inset-0  bg-opacity-100 backdrop-blur-sm 
            flex flex-col items-center justify-center opacity-0  translate-y-3
             pointer-events-none transition-all duration-300 ">
  
<div class="flex gap-0.5 ">

  <div class="w-60 h-9  border-t-transparent rounded-full  delay-300 mb-5">
    <img src="/img/oca.png" alt="" class="w-60 h-15 ">
  </div>
</div>

<div class="flex justify-center items-end-safe b-5 gap-1.5 z-10">
    <div class="text-slate-800  ">Actualizando datos un momento por favor </div>
    <div class="w-2 h-2 border bg-neutral-900 rounded-full  animate-bounce animation-delay-100"> </div>
    <div class="w-2 h-2 border bg-neutral-900 rounded-full  animate-bounce  animation-delay-300"> </div>
    <div class="w-2 h-2 border bg-neutral-900 rounded-full   animate-bounce animation-delay-500"> </div>
</div>


</div>
