---
import Basemodal from "../baseModales/basemodal.astro";
import TituloBase from "../titulos/tituloBase.astro";
import Cargue from "../input_cargue/cargue.astro";
import DivBotones from "../baseModales/divBotones.astro";
import Cancelar from "../botones/cancelar.astro";
import Botonconfirmar from "../botones/botonconfirmar.astro";
import TextosBase from "../textos/textosBase.astro";
interface Props {
  cancelar_btn: string;
  cargar_btn: string;
  id: string;
}
const { cancelar_btn, cargar_btn, id } = Astro.props;
---

<Basemodal id={id}>
  <TituloBase titulo="Cargue de actas" id="cargue_actas" slot={"titulo"} />

  <Cargue
    slot="body"
    texto="Arrastra y suelta tu archivo aquí"
    formatos="Formatos soportados: PDF, JPG, PNG"
    class="h-[250px] gap-y-4"
  />
  <TextosBase
    slot="body"
    contenido="Archivos pendientes"
    class="justify-start px-9 mt-3"
  />
  <div class="flex flex-col gap-2 w-full px-9" slot="body">
    <div class="flex justify-between text-sm text-gray-500">
      <span>Subiendo archivo...</span>
      <span>45%</span>
    </div>

    <div class="w-full h-2 bg-gray-200 rounded-full overflow-hidden">
      <div class="relative h-full bg-green-500 w-[67%] overflow-hidden">
        <!-- barra blanca -->
        <div
          class="absolute top-0 left-0 h-full w-1/3 bg-white/50 animate-barra"
        >
        </div>
      </div>
    </div>
  </div>
  <DivBotones slot="botones">
    <Cancelar idB={cancelar_btn} textcontent="Cancelar" />
    <Botonconfirmar idBC={cargar_btn} textcontent="Guardar Accesorio" />
  </DivBotones>
</Basemodal>
