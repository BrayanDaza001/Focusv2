---
import TituloBase from "../titulos/tituloBase.astro";
import { Icon } from "astro-icon/components";
---

<div class="w-full px-5 flex flex-col space-y-5" id="modal-informativo-vacio">
  <div class="flex items-center w-full justify-center">
    <TituloBase titulo="Sin datos para la consulta" class="font-semibold" />
  </div>
  <div
    class="w-full bg-white flex flex-col items-center justify-center h-[250px] space-y-3 rounded-2xl border border-dashed border-gray-400"
  >
    <div
      class="bg-zinc-200 rounded-full flex items-center justify-center w-16 h-16"
    >
      <Icon name="folder" class="text-zinc-300 w-12 h-12" />
    </div>
    <p class="text-zinc-300 w-1/2">
      Ingrese el número de identificación arriba para visualizar la información
      del usuario y generar el paz y salvo correspondiente.
    </p>
  </div>
</div>
