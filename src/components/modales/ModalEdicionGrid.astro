---
import Basemodal from "../baseModales/basemodal.astro";
import Cancelar from "../botones/cancelar.astro";
import BotonConfirmar from "../botones/botonconfirmar.astro";

interface Props {
  id?: string;
  titulo?: string;
  descripcion?: string;
}

const {
  id = "grid-edit-modal",
  titulo = "Editar registro",
  descripcion = "Actualiza la información del registro seleccionado.",
} = Astro.props;
---

<Basemodal
  id={id}
  class="w-[95vw] max-w-[860px] h-auto min-h-[460px] max-h-[90vh] justify-start py-6 overflow-y-auto"
>
  <div slot="titulo" class="w-full px-6 md:px-8">
    <p
      id={`${id}-eyebrow`}
      class="text-xs font-semibold uppercase tracking-[0.24em] text-blue-600"
    >
      Edici&oacute;n
    </p>
    <h2 id={`${id}-title`} class="mt-2 text-2xl font-bold text-slate-800">
      {titulo}
    </h2>
    <p id={`${id}-description`} class="mt-2 text-sm text-slate-500">
      {descripcion}
    </p>
  </div>

  <div slot="body" class="w-full px-6 md:px-8">
    <form id={`${id}-form`} class="w-full">
      <div
        id={`${id}-fields`}
        class="grid w-full grid-cols-1 gap-4 md:grid-cols-2"
      ></div>
    </form>
  </div>

  <div
    slot="botones"
    class="flex w-full flex-col-reverse gap-3 px-4 pb-2 md:flex-row md:justify-end"
  >
    <Cancelar idB={`${id}-cancel`} textcontent="Cancelar" />
    <BotonConfirmar
      idBC={`${id}-confirm`}
      textcontent="Confirmar"
      class="w-full md:w-[200px]"
    />
  </div>
</Basemodal>
