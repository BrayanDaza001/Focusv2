---
import CuerpoBase from "../baseModales/cuerpo_base.astro";
import TitulosBase from "../titulos/tituloBase.astro";
import { Icon } from "astro-icon/components";
import LabelBase from "../baseModales/labelBase.astro";
import Baseinput from "../baseModales/baseinput.astro";
import Select from "../baseModales/select.astro";
import BaseTextarea from "../baseModales/baseTextarea.astro";
import DivBotones from "../baseModales/divBotones.astro";
import Cancelar from "../botones/cancelar.astro";
import Botonconfirmar from "../botones/botonconfirmar.astro";
interface Props {
  cancelar_editar_accesorio: string;
  guardar_editar_accesorio: string;
}
const { cancelar_editar_accesorio, guardar_editar_accesorio } = Astro.props;
---

<CuerpoBase className="w-140 justify-around h-auto " id="modal_edit_accesorios">
  <TitulosBase titulo="Editar Accesorio" slot="titulo" />
  <div slot="fields">
    <div class="flex flex-row w-full space-x-2 h-60">
      <div class="w-6/12 flex flex-col items-center justify-around">
        <h5 class="text-gray-400 w-full mb-1 font-bold">Imagen Actual</h5>
        <div
          class="w-full h-full text-gray-300 bg-zinc-100 flex items-center justify-center"
        >
          <Icon name="camera" class="w-1/2 h-1/2" />
        </div>
        <a href="" class="text-sky-600 font-bold hover:cursor-pointer"
          >Cambiar imagen</a
        >
      </div>

      <div class="5/12 flex flex-col justify-evenly">
        <div class="">
          <LabelBase
            textL="Nombre del Accesorio"
            forLabel={"accesorio_agregar"}
          />

          <Baseinput
            nameIn="accesorio_agregar"
            placeH="Ej: Mouse Ergonómico Logitech"
            typeIn="text"
            dataId="accesorio_agregar"
          />
        </div>
        <div class="flex flex-row gap-x-2.5">
          <div class="min-w-6/12">
            <LabelBase textL="CATEGORIA" forLabel={"categoria"} />
            <Select />
          </div>
          <div>
            <LabelBase textL="STOCK " forLabel={"stock"} />
            <Baseinput
              nameIn="stock"
              placeH="0"
              typeIn="number"
              dataId="stock"
            />
          </div>
        </div>
      </div>
    </div>
    <div>
      <LabelBase textL="Descripcion (opcional) " />
      <div class="mt-3">
        <BaseTextarea
          placeHta="Mouse ergonómico con conexión USB y sensor óptico de alta precisión."
        />
      </div>
    </div>
    <DivBotones slot="botones">
      <Cancelar idB={cancelar_editar_accesorio} textcontent="Cancelar" />
      <Botonconfirmar
        idBC={guardar_editar_accesorio}
        textcontent="Actualizar Cambios"
      />
    </DivBotones>
  </div>
</CuerpoBase>
