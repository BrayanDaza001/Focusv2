---
interface Props {
  id: string;
  idSpan: string;
}

import { Icon } from "astro-icon/components";

const { id, idSpan } = Astro.props;

const mensajeSpan =
  idSpan === "span-validador"
    ? "Elemento eliminado correctamente"
    : "Error al cargar";
---

<div
  class="flex items-center gap-3 px-5 py-3 rounded-full
  bg-gray-200 text-gray-700 font-semibold
  shadow-md w-fit"
>
  <div
    class={`flex items-center justify-center w-6 h-6 rounded-full ${
      id === "validador" ? "bg-green-500" : "bg-red-500"
    }`}
  >
    {
      id === "validador" ? (
        <Icon name="mdi:check" class="w-4 h-4 text-white" />
      ) : (
        <Icon name="mdi:close" class="w-4 h-4 text-white" />
      )
    }
  </div>

  <span id={idSpan}>{mensajeSpan}</span>
</div>
