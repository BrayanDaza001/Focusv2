---
import BotonBase from "../botones/BotonBase.astro";
import TitulosActas from "../titulos/titulosActas.astro";
import Cargue from "../input_cargue/cargue.astro";
import { Icon } from "astro-icon/components";
import type { ElementoActa } from "../../types/ElementoActa";

interface Props {
  idModal: string;
  idElemento: string;
  accesorio: boolean;
  titulo: string;
  icono: string;
  mostrarCargue?: boolean;
  cargueProps?: Record<string, any>;
  idCancelar: string;
  idConfirmar: string; // obligatorio
  textoCancelar?: string;
  textoConfirmar?: string;
  elementos: ElementoActa[];
}

const {
  idModal,
  titulo,
  icono,
  mostrarCargue = false,
  cargueProps = {},
  idCancelar,
  idConfirmar,
  textoCancelar = "Volver",
  textoConfirmar = "Confirmar y Generar",
  idElemento,
  accesorio = false,
} = Astro.props as Props;
---

<div
  id={idModal}
  class="flex items-center w-full h-full justify-center bg-gray-300/50 fixed inset-0 opacity-0 pointer-events-none transition-opacity duration-300 z-50"
>
  <div
    class="space-y-4 bg-white w-full max-w-[740px] max-h-[90vh] overflow-hidden p-2 flex flex-col justify-center rounded-2xl"
  >
    <div class="flex gap-x-3 justify-start items-center relative">
      <TitulosActas icono={icono} titulo={titulo} />
      {
        accesorio && (
          <button
            type="button"
            id="btn_abrir_accesorios_acta"
            class="bg-[rgb(37,99,235)] text-white px-3 py-1 rounded-md absolute right-5 hover:cursor-pointer transition-all duration-200 active:scale-95"
          >
            <Icon name="mdi:plus" class="w-4 h-4" />
          </button>
        )
      }
    </div>
    <div
      class="bg-white h-full max-h-[80vh] overflow-y-auto border-t-[0.2px] border-zinc-200 w-full"
    >
      <div class="w-full h-full p-4">
        <div class="space-y-2 w-full bg-[rgb(246,246,246)] rounded-md p-1">
          <h3 class="text-gray-700 font-semibold">Elementos seleccionados</h3>
          <div class="flex flex-col w-full h-auto">
            <div class="flex flex-col w-full h-auto p-1 space-y-2">
              <!-- {
                elementos?.map((el) => (
                  <div
                    class="w-full flex flex-row gap-2 p-2 justify-between bg-white rounded-md"
                    id={idElemento}
                  >
                    <div class="flex items-center w-full flex justify-start">
                      <Icon
                        name={el.icono || "arrow-left"}
                        class="w-4 h-4 text-gray-600"
                      />
                      <p class="text-gray-700 font-bold">{el.nombre}</p>
                    </div>
                    <p class="text-gray-700 text-center">{el.valor}</p>
                  </div>
                ))
              } -->
              <div
                id={idElemento}
                class="flex flex-col w-full max-h-88 overflow-y-auto gap-2 p-1"
              >
              </div>
            </div>
          </div>
        </div>
      </div>
      {
        mostrarCargue && (
          <Cargue
            texto={"Arrastre aqui el "}
            actividad={"Acta de robo"}
            formatos={"Soporta PDF, JPG, PNG (Max 5MB)"}
            para={"ActaRobo"}
          />
        )
      }
      <div class="flex felx-col justify-between p-1 mt-3">
        <BotonBase
          tipo="cancelar"
          textcontent={textoCancelar}
          idBC={idCancelar}
        />
        <BotonBase
          tipo="default"
          textcontent={textoConfirmar}
          idBC={idConfirmar}
        />
      </div>
    </div>
  </div>
</div>

<!-- s -->
