---
import BotonBase from "../botones/BotonBase.astro";
import { Icon } from "astro-icon/components";
import TitulosActas from "../titulos/titulosActas.astro";
import Cargue from "../input_cargue/cargue.astro";
import { preguntasFormulario } from "../../utils/formulario/preguntas";

const registros = [
  {
    id: 1,
    imagen: "mouse",
    nombre: "Mouse Óptico Logitech",
    categoria: "Periféricos",
    stock: 42,
    fecha: "2026-04-01",
    estado: "Asignado",
  },
  {
    id: 2,
    imagen: "keyboard",
    nombre: "Teclado Mecánico Redragon",
    categoria: "Periféricos",
    stock: 15,
    fecha: "2026-04-02",
    estado: "Disponible",
  },
  {
    id: 3,
    imagen: "monitor",
    nombre: 'Monitor 24" Samsung',
    categoria: "Pantallas",
    stock: 2,
    fecha: "2026-04-03",
    estado: "Asignado",
  },
  {
    id: 4,
    imagen: "laptop",
    nombre: "Laptop HP EliteBook",
    categoria: "Computadores",
    stock: 5,
    fecha: "2026-04-04",
    estado: "En mantenimiento",
  },
  {
    id: 5,
    imagen: "printer",
    nombre: "Impresora Epson L3250",
    categoria: "Oficina",
    stock: 8,
    fecha: "2026-04-05",
    estado: "Disponible",
  },
  {
    id: 6,
    imagen: "headphones",
    nombre: "Audífonos Sony WH-1000XM4",
    categoria: "Audio",
    stock: 12,
    fecha: "2026-04-06",
    estado: "Asignado",
  },
];
---

<div
  id="modal_registro_elementos"
  class="flex items-center w-full h-full justify-center bg-gray-300/50 opacity-0 pointer-events-none fixed inset-0"
>
  <div
    class="space-y-4 bg-white w-full max-w-3xl max-h-[90vh] overflow-hidden p-2 flex flex-col justify-center rounded-2xl"
  >
    <div class="flex gap-x-3 justify-start items-center">
      <TitulosActas icono={"documentCheck"} titulo={"Formulario de Registro"} />
    </div>
    <form
      class="bg-white h-full overflow-y-auto border-t-[0.2px] border-zinc-200 w-full"
    >
      <div class="w-full h-full p-4 space-y-4">
        <div class="space-y-2 w-full rounded-md p-1 bg-slate-50">
          <div class="flex items-center justify-between">
            <h3 class="text-gray-700 font-semibold">
              Preguntas del formulario
            </h3>
            <span class="text-xs text-slate-500">Máximo 10 preguntas</span>
          </div>
          <div id="registro-preguntas" class="grid gap-3"></div>
        </div>
        <div class="w-full flex flex-col mt-2">
          <label for="textarea-observaciones" class="font-bold text-slate-700"
            >Observaciones</label
          >

          <textarea
            id="textarea-observaciones"
            name="textarea-observaciones"
            placeholder="Escriba acá las observaciones"
            class="w-full min-h-[120px] rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-blue-500 focus:outline-none"
          ></textarea>
        </div>
      </div>
      <div class="w-full flex justify-center items-center flex-col px-3.5 pb-4">
        <div class="mb-2 w-full h-full flex flex-row space-x-3">
          <Icon name={"camera"} class={"text-blue-500 w-6 h-6"} />
          <p class="text-gray-700 font-semibold">Carga de fotos</p>
        </div>

        <Cargue
          texto={"Arrastra y suelta imágenes aquí"}
          formatos={"Formatos soportados: JPG, PNG (Max 5MB)"}
          para={"actaEstadoElemento"}
        />
      </div>
    </form>
    <div class="flex flex-wrap justify-between gap-3 p-1 mt-3">
      <BotonBase
        tipo="cancelar"
        textcontent="Volver"
        idBC="cancelar_formulario"
      />
      <BotonBase
        tipo="default"
        textcontent="Confirmar y Generar"
        idBC="confirmar_formulario"
      />
    </div>
  </div>
</div>
