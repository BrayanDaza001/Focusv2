import Cancelar from "../botones/cancelar.astro";
import { Icon } from "astro-icon/components";
import TitulosActas from "../titulos/titulosActas.astro";
import Cargue from "../input_cargue/cargue.astro";
const registros = [
  {
    id: 1,
    imagen: "mouse",
    nombre: "Mouse Óptico Logitech",
    categoria: "Periféricos",
    stock: 42,
    fecha: "2026-04-01",
    estado: "Asignado",
  },
  {
    id: 2,
    imagen: "keyboard",
    nombre: "Teclado Mecánico Redragon",
    categoria: "Periféricos",
    stock: 15,
    fecha: "2026-04-02",
    estado: "Disponible",
  },
  {
    id: 3,
    imagen: "monitor",
    nombre: 'Monitor 24" Samsung',
    categoria: "Pantallas",
    stock: 2,
    fecha: "2026-04-03",
    estado: "Asignado",
  },
  {
    id: 4,
    imagen: "laptop",
    nombre: "Laptop HP EliteBook",
    categoria: "Computadores",
    stock: 5,
    fecha: "2026-04-04",
    estado: "En mantenimiento",
  },
  {
