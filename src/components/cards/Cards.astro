---
import { Icon } from "astro-icon/components";
interface Props {
  size?: "sm" | "md";
  dark?: boolean;
  name: string;
  titulo: string;
  descripcion: string;
  accion_button: string;
  bgClass?: string;
  info?: boolean;
  infoDescripcion?: string;
  hrefLink?: string;
}

const {
  size = "sm",
  dark = false,
  name,
  titulo,
  descripcion,
  accion_button,
  info = false,
  infoDescripcion,
  hrefLink,
} = Astro.props;

const sizeMap = {
  sm: "w-4/12",
  md: "w-8/12",
};

const bgClass = dark ? "bg-slate-700" : "bg-white";
const textClassIcon = dark ? "text-white" : "text-blue-600";
const bgClassbutton = dark
  ? "bg-slate-600/60 active:bg-white active:text-slate-600 "
  : "bg-blue-600  active:bg-white active:text-blue-600 border border-blue-600";
const bgClassIcon = dark ? "bg-slate-600/60" : "bg-gray-600/25";
const textText = dark ? "text-white" : "text-gray-400";
const textTitle = dark ? "text-white" : "text-slate-900";
---

<div
  class={`${sizeMap[size]} ${bgClass} p-5 space-y-3 flex flex-col justify-around`}
>
  <div class={`rounded-md  flex items-center justify-start  `}>
    {
      info ? (
        <div
          class={`${textClassIcon} ${textClassIcon} ${bgClassIcon} w-auto p-2  border-sm h-auto text-xs font-bold`}
        >
          {infoDescripcion}
        </div>
      ) : (
        <div
          class={`rounded-md  ${bgClassIcon} w-8 h-8 flex items-center justify-center `}
        >
          <Icon name={name} class={`${textClassIcon} text-2xl`} />
        </div>
      )
    }
  </div>
  <h3 class={`text-lg font-bold ${textTitle}`}>{titulo}</h3>
  <p class={`${textText}`}>{descripcion}</p>
  <a
    href={hrefLink}
    class={`text-white ${bgClassbutton} cursor-pointer p-2 rounded-md  transition-all duration-200 active:scale-90 w-[150px] text-center`}
    >{accion_button}</a
  >
</div>
