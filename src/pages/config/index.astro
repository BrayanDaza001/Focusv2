---
import Layoutv2 from "../../layouts/Layoutv2.astro";
import TituloInicial from "../../components/baseModales/tituloInicial.astro";
import Cards from "../../components/cards/Cards.astro";
---

<Layoutv2 titulo="Editar Formulario">
  <div class="flex flex-col w-full px-10 gap-y-5 mb-5">
    <TituloInicial
      titulo="Configuracion"
      texto="Configure y administre las opciones de su entorno"
    />
    <section class="flex flex-col w-full h-full gap-y-2.5">
      <section class="w-full h-60 flex *:bg-white *:rounded-lg gap-x-1">
        <Cards
          name="consulta"
          titulo="Configurar Formulario"
          descripcion="Ingrese y configure las preguntas del formulario de asignacion de equipos"
          accion_button="Ingresar"
          size="md"
          hrefLink="/config/enlaces/formulario"
        />
        <Cards
          name="reporte"
          titulo="Configurar Formulario de Paz y salvo"
          descripcion="Preguntas del formulario de paz y salvo"
          accion_button="Ingresar"
          size="md"
          hrefLink="/config/enlaces/PazYsalvo"
        />
      </section>
