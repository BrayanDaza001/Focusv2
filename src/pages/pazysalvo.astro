---
import Layoutv2 from "../layouts/Layoutv2.astro";
import TituloInicial from "../components/baseModales/tituloInicial.astro";
import Botonconfirmar from "../components/botones/botonconfirmar.astro";
import SinDatos from "../components/modales/SinDatos.astro";
---

<Layoutv2 titulo="Soporte > Paz y Salvo">
  <div class="flex flex-col w-full px-10 gap-y-5 mb-5">
    <TituloInicial titulo="Paz y Salvo" texto="Consulta de paz y salvo" />
    <div id="tabla-paz" class="w-23/24 self-center mt-3 .tablas"></div>
  </div>
  <div class="flex items-center justify-end w-[95%]
  mt-2">
    <Botonconfirmar
      idBC="cargue_acta"
      textcontent="Cargar acta"
      tipo="default"
    />
  </div>
</Layoutv2>

<script src="../utils/pazYsalvo/paz.js"></script>
