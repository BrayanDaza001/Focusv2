---
import Layoutv2 from "../layouts/Layoutv2.astro";
import ModalEdicionGrid from "../components/modales/ModalEdicionGrid.astro";
---

<Layoutv2 titulo={"Administracion > Usuarios"}>
  <section class="flex w-full flex-col gap-6 px-4 py-6 md:px-8 xl:px-10">
    <div class="flex flex-col gap-2">
      <span class="text-sm font-semibold uppercase tracking-[0.24em] text-slate-500">
        Administracion
      </span>
      <div class="flex flex-col gap-1">
        <h1 class="text-3xl font-bold tracking-tight text-slate-800">
          Usuarios
        </h1>
        <p class="max-w-3xl text-sm text-slate-600 md:text-base">
          Administra usuarios internos, revisa su rol y consulta el estado de acceso
          desde una tabla clara y optimizada para escritorio y m&oacute;vil.
        </p>
      </div>
    </div>

    <div class="rounded-[28px] border border-slate-200/80 bg-white/90 p-4 shadow-sm backdrop-blur md:p-6">
      <div class="mb-5 flex flex-col gap-2 border-b border-slate-200 pb-4 md:flex-row md:items-end md:justify-between">
        <div class="space-y-1">
          <h2 class="text-xl font-semibold text-slate-800">Directorio de usuarios</h2>
          <p class="text-sm text-slate-500">
            Busca por nombre, correo o rol y gestiona cada perfil desde la tabla.
          </p>
        </div>
        <div class="inline-flex w-fit items-center rounded-full border border-emerald-200 bg-emerald-50 px-3 py-1 text-xs font-semibold text-emerald-700">
          6 usuarios registrados
        </div>
      </div>

      <div id="tabla-usuarios" class="tabla-usuarios-grid overflow-hidden rounded-3xl"></div>
    </div>
  </section>

  <ModalEdicionGrid
    id="grid-edit-modal"
    titulo="Editar usuario"
    descripcion="Actualiza la información del usuario seleccionado."
  />
</Layoutv2>

<script src="../utils/usuarios/tablaUsuarios.js"></script>
