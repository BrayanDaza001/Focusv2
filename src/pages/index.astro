---
import "../styles/global.css";
import { Icon } from "astro-icon/components";
---

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="generator" content={Astro.generator} />
  <title>F.O.C.U.S</title>
</head>
<body>
  <main class="font-display bg-background-light dark:bg-background-dark">
    <div
      class="relative flex min-h-screen w-full flex-col items-center justify-center group/design-root overflow-hidden p-4"
    >
      <div
        class="absolute -top-1/4 -left-1/4 w-96 h-96 bg-slate-500 rounded-full blur-3xl opacity-50 dark:opacity-30 animate-[spin_20s_linear_infinite]"
      >
      </div>
      <div
        class="absolute -bottom-1/4 -right-1/4 w-96 h-96 bg-slate-500 rounded-full blur-3xl opacity-50 dark:opacity-30 animate-[spin_20s_linear_infinite_reverse]"
      >
      </div>
      <div
        class="relative w-full max-w-5xl mx-auto z-10 grid grid-cols-1 lg:grid-cols-2 items-center justify-center gap-12 lg:gap-16 bg-white/50 dark:bg-background-dark/50 backdrop-blur-xl p-8 rounded-xl border border-gray-200/50 dark:border-gray-200 shadow-lg"
      >
        <div class="flex flex-col items-center">
          <div class="w-full max-w-md">
            <div class="mb-6 flex items-center justify-center">
              <div
                class="w-12 h-12 bg-slate-500 flex items-center justify-center rounded-full"
              >
                <svg
                  class="h-7 w-7 text-white"
                  fill="currentColor"
                  viewBox="0 0 24 24"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <path
                    d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm-1-13h2v6h-2zm0 8h2v2h-2z"
                  ></path>
                </svg>
              </div>
            </div>
            <h1
              class="text-[#111418] tracking-tight text-3xl font-bold text-center pb-2 pt-2"
            >
              Bienvenido a Focus
            </h1>
            <p
              class="text-muted-light dark:text-muted-dark text-base font-normal text-center pb-8"
            >
              Ingresa credenciales para acceder
            </p>
            <div class="flex w-full flex-col items-center gap-4">
              <label class="flex flex-col w-full">
                <p
                  class="text-[#111418] text-sm font-medium leading-normal pb-2"
                >
                  Nombre de usuario
                </p>
                <div
                  class="flex w-full flex-1 items-stretch rounded-lg border border-[#dbe0e6] focus-within:ring-2 focus-within:ring-slate-500"
                >
                  <input
                    class="form-input flex w-full min-w-0 flex-1 resize-none overflow-hidden rounded-l-lg text-[#111418] focus:outline-0 focus:ring-0 border-0 bg-white h-12 placeholder:text-[#617589] dark:placeholder:text-gray-500 px-4 pr-2 text-base font-normal leading-normal"
                    placeholder="Ingresa tu usuario"
                    type="text"
                    value=""
                    id="date-user"
                  />
                </div>
              </label>
              <label class="flex flex-col w-full">
                <p
                  class="text-[#111418] text-sm font-medium leading-normal pb-2"
                >
                  Contraseña
                </p>
                <div
                  class="flex w-full flex-1 items-stretch rounded-lg border border-[#dbe0e6] focus-within:ring-2 focus-within:ring-slate-500"
                >
                  <input
                    class="form-input flex w-full min-w-0 flex-1 resize-none overflow-hidden rounded-l-lg text-[#111418] focus:outline-0 focus:ring-0 border-0 bg-white h-12 placeholder:text-[#617589] dark:placeholder:text-gray-500 px-4 pr-2 text-base font-normal leading-normal"
                    placeholder="Ingresa tu contraseña"
                    type="password"
                    value=""
                    id="input-password"
                  />
                  <div
                    class="text-[#617589] flex bg-white items-center justify-center pr-4 rounded-r-lg"
                  >
                    <span
                      class="material-symbols-outlined cursor-pointer"
                      data-icon="visibility"
                      ><Icon
                        name="openEye"
                        class="w-8 h-8 text-gray-700/70"
                        id="icon-login-open"
                      />
                      <Icon
                        name="closeEye"
                        class="w-8 h-8 text-gray-700/70 hidden"
                        id="icon-login-close"
                      /></span
                    >
                  </div>
                </div>
              </label>
              <div class="w-full flex justify-end pt-1 flex-col">
                <span
                  class="self-center text-red-700 font-medium opacity-0 transition-opacity duration-300"
                  id="span-error-clave"
                >
                  Error
                </span>
              </div>
              <div class="w-full flex flex-col gap-4 mt-4">
                <button
                  class="flex w-full items-center justify-center rounded-lg bg-slate-600 text-white text-base font-bold h-12 hover:bg-slate-300 hover:text-slate-500 transition-all shadow-lg shadow-slate-400/20 cursor-pointer"
                  id="btn-login"
                >
                  Ingresar
                </button>
              </div>
            </div>
          </div>
          <div
            class="mt-8 text-center text-sm text-muted-light dark:text-muted-dark"
          >
            Revisa tus reporte de facturacion <br />
          </div>
        </div>
        <div
          class="hidden lg:flex w-full h-full items-center justify-center p-8"
        >
          <div class="relative w-full max-w-md">
            <div
              class="absolute inset-0 bg-linear-to-tr from-slate-400 to-slate-500 rounded-full blur-3xl opacity-30"
            >
            </div>
            <img
              alt="Abstract technology illustration"
              class="relative w-full h-100 object-cover rounded-xl shadow-md"
              src="/img/login-oca.jpg"
            />
          </div>
        </div>
      </div>
    </div>
  </main>
</body>
<script src="../utils/login/eyes.js"></script>
<!-- <script src="../utils/login/login.js"></script> -->
