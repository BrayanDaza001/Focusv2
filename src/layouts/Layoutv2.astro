---
import Header from "../components/header.astro";
import Aside from "../components/aside.astro";
import "../styles/global.css";
interface Props {
  titulo: string; // 🔴 obligatorio
}
const { titulo } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined"
      rel="stylesheet"
    />

    <meta name="generator" content={Astro.generator} />
    <title>F.O.C.U.S</title>
  </head>
  <body class="font-display min-h-screen flex w-full">
    <!-- Aside -->
    <Aside />

    <!-- Contenedor derecho -->
    <div
      class="flex flex-col flex-1 h-full bg-gradient-to-tl bg-gradient-to-br from-blue-300/30 via-blue-150/20 to-slate-500/20"
    >
      <!-- Header -->
      <Header titulo={titulo} />

      <!-- Contenido con scroll -->
      <main class="flex-1 min-h-0 overflow-y-auto relative">
        <slot />
      </main>
    </div>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
<script
  src="https://cdn.jsdelivr.net/npm/signature_pad@4.0.0/dist/signature_pad.umd.min.js"
></script>
